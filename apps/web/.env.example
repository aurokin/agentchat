# Agentchat (Web) Environment Variables
#
# apps/web/.env.local is generated by `bun scripts/local/setup-tree.ts`
# (run automatically by worktrunk's post-start hook in linked worktrees;
# run manually once in the main checkout).
#
# Portless sets PORT and routes the app at https://agentchat-web.localhost
# (or https://<branch>.agentchat-web.localhost in a linked worktree).
#
# These keys end up in the generated .env.local:
#   NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
#   NEXT_PUBLIC_AGENTCHAT_SERVER_URL=https://agentchat-server.localhost
#
# Optional opt-in for extra LAN hostnames (comma-separated). Portless
# subdomains and `*.localhost` already pass next.config.ts's
# allowedDevOrigins check, so this is only needed for additional plain LAN
# IPs or custom hostnames.
#   NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20,devbox.local
