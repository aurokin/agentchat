# Agentchat (Web) Environment Variables
#
# apps/web/.env.local is no longer auto-generated. apps/web/next.config.ts
# loads the repo-root .env.convex.local at startup and derives:
#   - NEXT_PUBLIC_CONVEX_URL  ← CONVEX_URL from .env.convex.local
#   - NEXT_PUBLIC_AGENTCHAT_SERVER_URL  ← `portless get agentchat-server`
# Both are worktree-aware. Anything already in process.env wins.
#
# Create apps/web/.env.local only for local-only overrides.
#
# Optional opt-in for extra LAN hostnames (comma-separated). Portless
# subdomains and `*.localhost` already pass next.config.ts's
# allowedDevOrigins check, so this is only needed for additional plain LAN
# IPs or custom hostnames.
#   NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20,devbox.local
