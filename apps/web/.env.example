# Agentchat (Web) Environment Variables
#
# bun run bootstrap generates apps/web/.env.local for the current checkout.
# Keep this file as the checked-in reference template.

# Dev server binding (generated by the local wrapper)
# PORT=4041
# HOST=0.0.0.0

# Convex client URL for the current local/dev deployment.
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# Agentchat backend server for the current checkout.
# Loopback hosts like localhost/127.0.0.1 are fine for local dev. When the web app
# is opened from another device on your LAN, Agentchat will automatically swap the
# loopback hostname for the current browser hostname and keep the configured port.
# NEXT_PUBLIC_AGENTCHAT_SERVER_URL=http://localhost:3031

# Optional comma-separated extra LAN hostnames or IPs to allow during Next dev.
# Agentchat already allows localhost, 127.0.0.1, and 0.0.0.0 by default.
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20,192.168.1.21,devbox.local
