# Agentchat (Server) Environment Variables
#
# apps/server/.env.local is generated by `bun scripts/local/setup-tree.ts`
# (run automatically by worktrunk's post-start hook in linked worktrees;
# run manually once in the main checkout).
#
# Portless sets PORT for the server. Convex creds come from
# ~/.config/agentchat/convex.env.
#
# These keys end up in the generated .env.local:
#   XDG_STATE_HOME=$HOME/.local/state/agentchat-trees/<branch>/xdg
#   BACKEND_TOKEN_SECRET=<generated>
#   RUNTIME_INGRESS_SECRET=<generated>
#   AGENTCHAT_CONVEX_SITE_URL=https://<deployment>.convex.site
